SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=1
TRUST_PROXY=1
MAX_UPLOAD_MB=100

# Use persistent paths on your host. Do not put these on an ephemeral filesystem.
INSTANCE_DIR=/data/instance
UPLOAD_DIR=/data/uploads
DATABASE_PATH=/data/instance/find_the_beat_v2.db
BRENT_CO_URL=https://brentco.netlify.app/
FIND_THE_BEAT_URL=https://findthebeatmusic.com
SECOND_CHANCE_URL=https://brentco.netlify.app/second-chance

# Optional privacy-safe analytics. Use one or the other.
GA_MEASUREMENT_ID=
PLAUSIBLE_DOMAIN=secondchancecareers.org

# Brent & Co central SSO. SSO_SHARED_SECRET must exactly match Brent & Co.
BRENT_SSO_URL=https://www.brentandco.org/sso/start
SSO_SHARED_SECRET=
SSO_TOKEN_TTL_SECONDS=900
SSO_CLOCK_SKEW_SECONDS=120
SSO_ACCEPTED_ISSUERS=brent-co-identity,brent-co-sso

# Optional job ingestion providers. Missing keys skip that provider safely.
CAREERONESTOP_API_KEY=
CAREERONESTOP_USER_ID=
USAJOBS_USER_AGENT=
USAJOBS_AUTH_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
